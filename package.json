{
  "name": "Overmind",
  "version": "0.6.0",
  "description": "Overmind Screeps AI",
  "license": "MIT",
  "author": "Ben Bartlett",
  "scripts": {
    "build": "vp run typecheck && vp pack",
    "typecheck": "vp lint --type-aware --type-check -A all",
    "docs": "typedoc",
    "test:unit": "vp test --project unit",
    "test:bundle": "vp test --project bundle",
    "lint": "vp lint src",
    "check": "vp check && vp run typecheck",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "clean": "rm -rf tsc-out && rm -rf dist",
    "push-main": "vp run build && node scripts/upload.cjs --destination main",
    "push-pserver": "vp run build && node scripts/upload.cjs --destination pserver",
    "test": "vp test"
  },
  "dependencies": {
    "columnify": "1.6.0"
  },
  "devDependencies": {
    "@screeps/common": "2.16.1",
    "@types/node": "^24.19.2",
    "@types/screeps": "^3.4.0",
    "typedoc": "^0.28.20",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite-plus": "1.5.0"
  },
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "packageManager": "pnpm@12.16.1"
}
