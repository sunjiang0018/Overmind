{
  "name": "Overmind",
  "version": "0.6.0",
  "description": "Overmind Screeps AI",
  "author": "Ben Bartlett",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bencbartlett/Overmind.git"
  },
  "homepage": "https://github.com/bencbartlett/Overmind#readme",
  "bugs": {
    "url": "https://github.com/bencbartlett/Overmind/issues"
  },
  "scripts": {
    "build": "npm run compile",
    "build:types": "tsc -p .",
    "typecheck": "tsc --noEmit -p .",
    "docs": "typedoc",
    "compile:rolldown": "node scripts/build.cjs",
    "test:unit": "node --test tests/*.test.cjs",
    "test:bundle": "node scripts/build.cjs && node --test tests/build/*.test.cjs",
    "lint": "tslint \"src/**/*.ts\"",
    "clean": "rm -rf tsc-out && rm -rf dist",
    "obfuscate": "tsc && javascript-obfuscator tsc-out/Overmind.js --output src/Overmind_obfuscated.js --compact false --self-defending true --string-array true --string-array-threshold 1 --string-array-encoding rc4 && javascript-obfuscator tsc-out/assimilation/Assimilator.js --output src/assimilation/Assimilator_obfuscated.js --compact false --self-defending true --string-array true --string-array-threshold 1 --string-array-encoding rc4",
    "compile": "node scripts/build.cjs",
    "push-main": "node scripts/build.cjs --destination main",
    "push-seasonal": "node scripts/build.cjs --destination seasonal",
    "push-pserver": "node scripts/build.cjs --destination pserver",
    "push-screepsplus": "node scripts/build.cjs --destination screepsplus",
    "test": "npm run test:unit && npm run test:bundle"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.16.1",
  "devDependencies": {
    "@screeps/common": "2.16.1",
    "@types/lodash": "4.17.27",
    "@types/lodash-screeps": "npm:@types/lodash@3.10.2",
    "@types/node": "^24.19.2",
    "@types/screeps": "^3.4.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "javascript-obfuscator": "^5.9.0",
    "lodash": "4.18.1",
    "rolldown": "1.2.16",
    "rollup-plugin-screeps": "^1.0.1",
    "tslint": "^6.1.3",
    "typedoc": "^0.28.20",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "dependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "columnify": "1.6.0",
    "onnxjs": "^0.1.8",
    "source-map": "0.8.0"
  }
}
